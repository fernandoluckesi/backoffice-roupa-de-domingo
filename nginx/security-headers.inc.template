# Cabecalhos de seguranca do backoffice (incluido em cada location com add_header proprio).
# Template: o entrypoint do nginx substitui ${STOREFRONT_ORIGIN} no start do container.
# CSP: so recursos proprios. Excecoes:
#  - img-src data: QR code do 2FA (gerado no navegador como data URL);
#  - img-src ${STOREFRONT_ORIGIN}: fotos dos produtos, servidas pela loja.
# style-src sem 'unsafe-inline': o Vite gera arquivos .css e o React aplica style via CSSOM.
# Ao trocar o dominio da loja, ajuste STOREFRONT_ORIGIN (runtime) e VITE_STOREFRONT_URL (build).
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: ${STOREFRONT_ORIGIN}; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" always;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "no-referrer" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
# Area interna: fora de buscadores (o robots.txt tambem bloqueia tudo)
add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
