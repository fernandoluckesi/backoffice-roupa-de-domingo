# URL base da API. Padrao "/api": mesma origem (proxy do Vite em dev, nginx em producao).
VITE_API_URL=/api
# Origem da loja: as imagens dos produtos (/products/...) sao servidas por ela.
VITE_STOREFRONT_URL=http://localhost:5273
# (opcional, so em dev) para onde o Vite repassa /api
# API_PROXY_TARGET=http://localhost:3333
# Producao: API_PROXY_TARGET=https://frontend-roupa-de-domingo-production.up.railway.app
